# Copy this file to .env and fill in the values before running the server.
# Keep the Service Role Key secret (do NOT commit to client-side code or public repos).

# Supabase project URL and keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJh... (optional for client-side SDK usage)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci... (REQUIRED for server-side operations)

# Supabase Storage
SUPABASE_STORAGE_BUCKET=uploads

# Server
PORT=5000
NODE_ENV=development

# Notes:
# - When SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set, the server will use Supabase for persistence.
# - If those are not set, the server will run in a dev fallback mode (in-memory default admin) so you can still log in locally.
# - Never expose the SUPABASE_SERVICE_ROLE_KEY in the browser or public repos.
